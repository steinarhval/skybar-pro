rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Tilgang gis kun via konsollen (eller en fremtidig betrodd backend).
    function teacherAccess() {
      return get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isSignedIn() && teacherAccess().enabled == true
        && (teacherAccess().expiresAt == null
          || (teacherAccess().expiresAt is timestamp && request.time < teacherAccess().expiresAt));
    }

    match /teachers/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    function isValidJoinCode(id) {
      return id.matches('^[A-Z0-9]{6}$');
    }

    function isString(x) { return x is string; }
    function isNumber(x) { return x is number; }
    function isMap(x) { return x is map; }

    // --- Public: join routing (read only) ---
    match /joinCodes/{joinCode} {
      allow get: if isValidJoinCode(joinCode);
      allow list: if false;
      allow create: if isTeacher() && isValidJoinCode(joinCode)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['sessionId', 'ownerId', 'createdAt', 'active'])
        && request.resource.data.sessionId is string
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.joinCode == joinCode
        && getAfter(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active';
      allow update: if isTeacher() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false;
      allow delete: if false;
    }

    // --- Owners (auth only) ---
    match /owners/{ownerId} {
      allow read, write: if isTeacher() && request.auth.uid == ownerId;
    }

    // --- Sessions ---
    match /sessions/{sessionId} {

      // Session metadata (auth only). Display/deltaker trenger ikke lese dette nå.
      allow get: if isTeacher() && (!exists(/databases/$(database)/documents/sessions/$(sessionId))
        || resource.data.ownerId == request.auth.uid);
      allow list: if false;
      allow create: if isTeacher() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.cleanupEnabled == true
        && request.resource.data.status == "active";
      allow update: if isTeacher() && resource.data.ownerId == request.auth.uid
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.status == "active"
        && request.resource.data.status in ["active", "ended"]
        && request.resource.data.get("cleanupEnabled", false) == resource.data.get("cleanupEnabled", false)
        && request.resource.data.joinCode == resource.data.joinCode;
      allow delete: if false;

      // --- Live state ---
      match /state/{docId} {
        allow read: if docId == "live";      // Display + deltaker kan lese state/live
        allow write: if isTeacher() && docId == "live"
          && getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data.status == "active";
      }

      // --- Rounds ---
      match /rounds/{roundId} {

        // Aggregated results: display reads only
        match /agg/{docId} {
          allow read: if docId == "live";
          allow write: if false; // kun server (Admin SDK) skal skrive
        }

        // Votes: participant create-only, never update/delete
        match /votes/{clientId} {

          // ✅ NYTT: Deltaker må kunne lese sin egen vote-doc for vote-lock.
          // Tillat kun GET (enkelt-dokument), aldri LIST (liste alle votes).
          allow get: if true;
          allow list: if false;

          allow create: if
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == "active"
            && get(/databases/$(database)/documents/sessions/$(sessionId)/state/live).data.roundId == roundId
            &&
            // kun create (ikke update)
            !exists(/databases/$(database)/documents/sessions/$(sessionId)/rounds/$(roundId)/votes/$(clientId))
            // grunnleggende struktur
            && isMap(request.resource.data)
            && request.resource.data.keys().hasOnly(['clientId', 'createdAt', 'mode', 'value'])
            && request.resource.data.clientId == clientId
            && isString(request.resource.data.mode)
            // createdAt skal settes av serverTimestamp fra klient (tillates som timestamp)
            ;

          allow update, delete: if false;
        }
      }
    }
  }
}

